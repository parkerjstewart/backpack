# AWS/Elastic Beanstalk deployment configuration

# AWS region and EB naming
AWS_REGION=us-east-1
APP_NAME=backpack
ENV_NAME=backpack-prod
CNAME_PREFIX=backpack-prod
INSTANCE_TYPE=t3.large
ROOT_VOLUME_GB=128

# Security
OPEN_NOTEBOOK_PASSWORD=replace-with-strong-password

# SurrealDB single-container settings
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=backpack
SURREAL_DATABASE=backpack

# At least one provider key is required
OPENAI_API_KEY=replace-with-provider-key

# Optional provider keys
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
