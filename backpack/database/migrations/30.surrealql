-- ============================================
-- Migration 30: Reconcile student_progress schema drift
-- Some databases applied an older variant of migration 22 and are missing
-- session-level fields required for tutor insights lookups.
-- ============================================

-- Remove stale per-goal fields if they still exist
REMOVE FIELD IF EXISTS learning_goal ON TABLE student_progress;
REMOVE FIELD IF EXISTS status ON TABLE student_progress;
REMOVE FIELD IF EXISTS confidence_score ON TABLE student_progress;
REMOVE FIELD IF EXISTS notes ON TABLE student_progress;
REMOVE INDEX IF EXISTS idx_progress_goal ON TABLE student_progress;

-- Ensure session-level fields exist
DEFINE FIELD IF NOT EXISTS module ON TABLE student_progress TYPE record<module>;
DEFINE FIELD IF NOT EXISTS session_id ON TABLE student_progress TYPE string;
DEFINE FIELD IF NOT EXISTS overall_summary ON TABLE student_progress TYPE option<string>;
DEFINE FIELD IF NOT EXISTS strongest_goal_id ON TABLE student_progress TYPE option<string>;
DEFINE FIELD IF NOT EXISTS weakest_goal_id ON TABLE student_progress TYPE option<string>;
DEFINE FIELD IF NOT EXISTS goal_insights ON TABLE student_progress FLEXIBLE TYPE option<array>;
DEFINE FIELD IF NOT EXISTS updated ON TABLE student_progress TYPE datetime DEFAULT time::now();

-- Backfill missing session IDs on legacy rows so a unique index can be created safely.
UPDATE student_progress
SET session_id = <string>id
WHERE type::is::none(session_id) OR session_id = "";

-- Ensure indexes required by API query patterns exist
REMOVE INDEX IF EXISTS idx_progress_module ON TABLE student_progress;
DEFINE INDEX idx_progress_module ON TABLE student_progress COLUMNS user, module;

REMOVE INDEX IF EXISTS idx_progress_session ON TABLE student_progress;
DEFINE INDEX idx_progress_session ON TABLE student_progress COLUMNS session_id UNIQUE;
